---
import textLogo from "../assets/text-logo.png";
---

<header class="header" id="main-header">
  <div class="container header-inner">
    <a href="/" class="logo-link">
      <div class="logo-container">
        <img src="favicon.svg" class="logo" alt="KeyPixel Logo" />
        <img src={textLogo.src} class="studio-logo-img" alt="Key Pixel" />
      </div>
    </a>

    <nav class="nav">
      <a href="#about" class="nav-link">About</a>
      <a href="#projects" class="nav-link">Projects</a>
      <a
        class="nav-contact-btn"
        href="https://mail.google.com/mail/?view=cm&to=keypixelstudios@gmail.com"
      >
        Contact
      </a>
    </nav>
  </div>
</header>

<style>
  .header {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: var(--nav-height);
    background-color: rgba(19, 16, 17, 0.85);
    backdrop-filter: blur(20px);
    z-index: 1000;
    display: flex;
    align-items: center;
    border-bottom: 1px solid var(--border-soft);
    transition: background-color 0.4s ease;
  }

  .header-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    width: 100%;
  }

  .logo-link {
    display: flex;
    align-items: center;
    gap: 12px;
    transition: transform 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    will-change: transform;
    text-decoration: none;
  }

  .logo-link:hover {
    transform: scale(1.05);
  }

  .logo-container {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .logo {
    width: 48px;
    height: 48px;
    filter: drop-shadow(0 0 15px rgba(var(--brand-primary-rgb), 0.3));
    image-rendering: pixelated;
    image-rendering: crisp-edges;
  }

  .studio-logo-img {
    height: 160px;
    width: auto;
    filter: drop-shadow(0 2px 10px rgba(var(--brand-primary-rgb), 0.2));
    image-rendering: pixelated;
    margin-left: -30px;
    margin-top: 5px;
  }

  .nav {
    display: flex;
    align-items: center;
    gap: 2.5rem;
  }

  .nav-link {
    font-size: 0.85rem;
    font-weight: 400;
    color: var(--text-muted);
    transition: all 0.3s ease;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    position: relative;
  }

  .nav-link::after {
    content: "";
    position: absolute;
    bottom: -4px;
    left: 0;
    width: 0;
    height: 2px;
    background: var(--brand-primary);
    transition: width 0.3s ease;
  }

  .nav-link:hover {
    color: white;
  }

  .nav-link:hover::after {
    width: 100%;
  }

  .nav-contact-btn {
    padding: 0.6rem 1.5rem;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid var(--border-soft);
    border-radius: 50px;
    color: white;
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 1px;
    transition: all 0.3s ease;
  }

  .nav-contact-btn:hover {
    background: var(--brand-primary);
    border-color: var(--brand-primary);
    box-shadow: 0 5px 15px var(--ui-glow);
    transform: translateY(-2px);
  }

  @media (max-width: 768px) {
    .nav {
      gap: 1.5rem;
    }

    .nav-link {
      display: none;
    }
  }
</style>
